src/frontend/node_modules/
src/frontend/.next/
src/frontend/.out/
src/frontend/build/
src/frontend/dist/

src/backend/Host/bin/
src/backend/Host/obj/
src/backend/**/bin/
src/backend/**/obj/
src/backend/**/.vs/
src/backend/**/.vscode/

# Test outputs
src/backend/Tests/**/bin/
src/backend/Tests/**/obj/

# IDE / OS
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Git
.git/
.gitignore
.github/

# Documentation (not needed at runtime)
docs/
*.md
!README.md
AGENTS.md
CHANGELOG.md
PLAN.md

# CI/CD
ci/
.cspell.json
.editorconfig
.prettierrc*
.eslintrc*
.tgitconfig

# Sandbox-specific
sandbox/
*.pdf
*.log

# Backend published output (rebuilt in Docker)
src/backend/publish/
src/backend/Host/publish/
