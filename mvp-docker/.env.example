# MVP Docker — Environment Configuration
# Copy to .env and adjust. DO NOT commit .env to git.

# JWT secret for the API (HS256, must be at least 32 chars, ideally 64+)
# Generate one with: openssl rand -base64 64
JWT_SECRET=REPLACE_ME_WITH_A_RANDOM_64_CHAR_SECRET_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Database credentials (matches docker-compose.yml)
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_mvp_password
POSTGRES_DB=erp_system

# Ports (change if conflicts with other local services)
POSTGRES_PORT=5432
API_PORT=5000
FRONTEND_PORT=3000
