# MVP Docker — Environment Configuration
# Copy to .env and adjust. DO NOT commit .env to git.

# JWT secret for the API (HS256, must be at least 32 chars, ideally 64+)
# Generate one with: openssl rand -base64 64
JWT_SECRET=REPLACE_ME_WITH_A_RANDOM_64_CHAR_SECRET_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Database credentials (matches docker-compose.yml)
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_mvp_password
POSTGRES_DB=erp_system

# Ports (change if conflicts with other local services)
POSTGRES_PORT=5432
API_PORT=5000
FRONTEND_PORT=3000

# Sprint 14: env-driven default admin user
# Set BOOTSTRAP_CREATE_DEFAULT_ADMIN=true to enable. Default is false (no admin created).
# When enabled, the bootstrap service creates an admin user on first run (Layer 2 = CLEAN install).
# CHANGE THE PASSWORD after first login in any non-demo deployment.
BOOTSTRAP_CREATE_DEFAULT_ADMIN=true
BOOTSTRAP_DEFAULT_ADMIN_EMAIL=admin@erp.local
BOOTSTRAP_DEFAULT_ADMIN_PASSWORD=ChangeMe1234!
BOOTSTRAP_DEFAULT_ADMIN_FULL_NAME=Administrator

# Frontend API URL (passed at BUILD time via docker-compose build args)
# Override this if your API is hosted on a different URL (e.g., behind a reverse proxy)
NEXT_PUBLIC_API_URL=http://localhost:5000

