{
  "name": "ActivityLog",
  "table": "activity_log",
  "version": "1.0.0",
  "module": "Activity",
  "description": "User-action activity log (login, refresh, logout) — separate from audit_log (entity CRUD). Created in Cycle 6 (DEC-073) as the first user-facing feature.",
  "fields": [
    { "name": "id", "type": "bigint", "nullable": false, "primary_key": true, "default": "nextval('activity_log_id_seq'::regclass)" },
    { "name": "company_id", "type": "uuid", "nullable": true,
      "foreign_key": { "table": "companies", "column": "id", "on_delete": "restrict" } },
    { "name": "user_id", "type": "uuid", "nullable": true,
      "foreign_key": { "table": "users", "column": "id", "on_delete": "set null" } },
    { "name": "action", "type": "varchar(40)", "nullable": false },
    { "name": "ip_address", "type": "varchar(45)", "nullable": true },
    { "name": "user_agent", "type": "varchar(255)", "nullable": true },
    { "name": "metadata", "type": "jsonb", "nullable": true },
    { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()" }
  ],
  "indexes": [
    { "name": "ix_activity_log_user_created", "columns": ["user_id", "created_at"] },
    { "name": "ix_activity_log_company_created", "columns": ["company_id", "created_at"] },
    { "name": "ix_activity_log_action_created", "columns": ["action", "created_at"] }
  ]
}
