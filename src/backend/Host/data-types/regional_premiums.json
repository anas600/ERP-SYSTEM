{
  "name": "RegionalPremium",
  "table": "regional_premiums",
  "version": "1.0.0",
  "module": "Projects",
  "fields": [
    { "name": "id", "type": "uuid", "nullable": false, "primary_key": true },
    { "name": "company_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "companies", "column": "id", "on_delete": "restrict" } },
    { "name": "project_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "projects", "column": "id", "on_delete": "restrict" } },
    { "name": "region", "type": "text", "nullable": false },
    { "name": "ndb_percent", "type": "numeric(5,2)", "nullable": false, "default": "1.5" },
    { "name": "cit_percent", "type": "numeric(5,2)", "nullable": false, "default": "5.0" },
    { "name": "ss_percent", "type": "numeric(5,2)", "nullable": false, "default": "0.0" },
    { "name": "is_active", "type": "boolean", "nullable": false, "default": "true" },
    { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()" }
  ],
  "indexes": [
    { "name": "ux_regional_premiums_project_region", "columns": ["project_id", "region"], "unique": true },
    { "name": "idx_regional_premiums_company_project", "columns": ["company_id", "project_id"] }
  ]
}
