{
  "name": "Account",
  "table": "accounts",
  "version": "1.0.0",
  "module": "Finance",
  "fields": [
    { "name": "id", "type": "uuid", "nullable": false, "primary_key": true },
    { "name": "company_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "companies", "column": "id", "on_delete": "restrict" } },
    { "name": "code", "type": "varchar(50)", "nullable": false },
    { "name": "name", "type": "varchar(200)", "nullable": false },
    { "name": "description", "type": "varchar(500)", "nullable": true },
    { "name": "type", "type": "integer", "nullable": false },
    { "name": "normal_balance", "type": "integer", "nullable": false },
    { "name": "parent_account_id", "type": "uuid", "nullable": true,
      "foreign_key": { "table": "accounts", "column": "id", "on_delete": "set_null" } },
    { "name": "is_intercompany", "type": "boolean", "nullable": false, "default": "false" },
    { "name": "is_postable", "type": "boolean", "nullable": false, "default": "true" },
    { "name": "is_active", "type": "boolean", "nullable": false, "default": "true" },
    { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()" },
    { "name": "updated_at", "type": "timestamptz", "nullable": false, "default": "now()" }
  ],
  "indexes": [
    { "name": "ix_accounts_company_code", "columns": ["company_id", "code"], "unique": true },
    { "name": "ix_accounts_company_parent", "columns": ["company_id", "parent_account_id"] }
  ]
}
