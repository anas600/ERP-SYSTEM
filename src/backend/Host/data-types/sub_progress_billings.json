{
  "name": "SubProgressBilling",
  "table": "sub_progress_billings",
  "version": "1.0.0",
  "module": "Projects",
  "fields": [
    { "name": "id", "type": "uuid", "nullable": false, "primary_key": true },
    { "name": "company_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "companies", "column": "id", "on_delete": "restrict" } },
    { "name": "sub_contract_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "sub_contracts", "column": "id", "on_delete": "restrict" } },
    { "name": "billing_number", "type": "varchar(50)", "nullable": false },
    { "name": "billing_date", "type": "date", "nullable": false },
    { "name": "period_from", "type": "date", "nullable": true },
    { "name": "period_to", "type": "date", "nullable": true },
    { "name": "work_completed_percent", "type": "numeric(5,2)", "nullable": false },
    { "name": "gross_amount", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "retention_deducted", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "previous_billings_amount", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "net_payable", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "status", "type": "int", "nullable": false, "default": "1" },
    { "name": "notes", "type": "text", "nullable": true },
    { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()" },
    { "name": "updated_at", "type": "timestamptz", "nullable": false, "default": "now()" }
  ],
  "indexes": [
    { "name": "ux_sub_progress_billings_sub_contract_number", "columns": ["sub_contract_id", "billing_number"], "unique": true },
    { "name": "ix_sub_progress_billings_sub_contract", "columns": ["sub_contract_id"], "unique": false }
  ]
}
