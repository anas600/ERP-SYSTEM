{
  "name": "PurchaseOrderLine",
  "table": "purchase_order_lines",
  "version": "1.0.0",
  "module": "Procurement",
  "fields": [
    { "name": "id", "type": "uuid", "nullable": false, "primary_key": true },
    { "name": "purchase_order_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "purchase_orders", "column": "id", "on_delete": "cascade" } },
    { "name": "item_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "items", "column": "id", "on_delete": "restrict" } },
    { "name": "quantity", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "unit_price", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "tax_rate", "type": "numeric(8,6)", "nullable": false, "default": "0" },
    { "name": "sub_total", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "line_order", "type": "integer", "nullable": false, "default": "1" }
  ],
  "indexes": [
    { "name": "ix_purchase_order_lines_po", "columns": ["purchase_order_id"] },
    { "name": "ix_purchase_order_lines_item", "columns": ["item_id"] }
  ]
}
