{
  "name": "UnitOfMeasure",
  "table": "units_of_measure",
  "version": "1.0.0",
  "module": "Inventory",
  "fields": [
    { "name": "id", "type": "uuid", "nullable": false, "primary_key": true },
    { "name": "company_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "companies", "column": "id", "on_delete": "restrict" } },
    { "name": "code", "type": "varchar(20)", "nullable": false },
    { "name": "name", "type": "varchar(100)", "nullable": false },
    { "name": "symbol", "type": "varchar(20)", "nullable": true },
    { "name": "is_active", "type": "boolean", "nullable": false, "default": "true" },
    { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()" }
  ],
  "indexes": [
    { "name": "ix_uom_company_code", "columns": ["company_id", "code"], "unique": true }
  ]
}
