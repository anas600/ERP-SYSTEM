{
  "name": "ProcessedEvent",
  "table": "processed_events",
  "version": "1.0.0",
  "module": "Shared",
  "fields": [
    { "name": "event_id", "type": "uuid", "nullable": false, "primary_key": true },
    { "name": "company_id", "type": "uuid", "nullable": true,
      "foreign_key": { "table": "companies", "column": "id", "on_delete": "restrict" } },
    { "name": "processed_at", "type": "timestamptz", "nullable": false, "default": "now()" }
  ],
  "indexes": [
    { "name": "ix_processed_events_company", "columns": ["company_id"] },
    { "name": "ix_processed_events_company_processed", "columns": ["company_id", "processed_at"] }
  ]
}
