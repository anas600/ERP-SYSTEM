{
  "name": "JournalLine",
  "table": "journal_lines",
  "version": "1.0.0",
  "module": "Finance",
  "fields": [
    { "name": "id", "type": "uuid", "nullable": false, "primary_key": true },
    { "name": "journal_entry_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "journal_entries", "column": "id", "on_delete": "cascade" } },
    { "name": "account_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "accounts", "column": "id", "on_delete": "restrict" } },
    { "name": "debit", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "credit", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "description", "type": "varchar(500)", "nullable": true },
    { "name": "line_number", "type": "integer", "nullable": false }
  ],
  "indexes": [
    { "name": "ix_journal_lines_entry", "columns": ["journal_entry_id"] },
    { "name": "ix_journal_lines_account", "columns": ["account_id"] }
  ]
}