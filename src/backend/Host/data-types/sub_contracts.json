{
  "name": "SubContract",
  "table": "sub_contracts",
  "version": "1.0.0",
  "module": "Projects",
  "fields": [
    { "name": "id", "type": "uuid", "nullable": false, "primary_key": true },
    { "name": "company_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "companies", "column": "id", "on_delete": "restrict" } },
    { "name": "project_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "projects", "column": "id", "on_delete": "restrict" } },
    { "name": "subcontractor_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "subcontractors", "column": "id", "on_delete": "restrict" } },
    { "name": "contract_number", "type": "varchar(50)", "nullable": false },
    { "name": "scope_of_work", "type": "text", "nullable": false },
    { "name": "contract_value", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "retention_percent", "type": "numeric(5,2)", "nullable": false, "default": "10.0" },
    { "name": "retention_release_billing", "type": "int", "nullable": false, "default": "3" },
    { "name": "start_date", "type": "date", "nullable": true },
    { "name": "end_date", "type": "date", "nullable": true },
    { "name": "status", "type": "int", "nullable": false, "default": "1" },
    { "name": "notes", "type": "text", "nullable": true },
    { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()" },
    { "name": "updated_at", "type": "timestamptz", "nullable": false, "default": "now()" }
  ],
  "indexes": [
    { "name": "ux_sub_contracts_project_number", "columns": ["project_id", "contract_number"], "unique": true },
    { "name": "ix_sub_contracts_subcontractor", "columns": ["subcontractor_id"], "unique": false }
  ]
}
