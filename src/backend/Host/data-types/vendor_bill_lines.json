{
  "name": "VendorBillLine",
  "table": "vendor_bill_lines",
  "version": "1.0.0",
  "module": "Procurement",
  "fields": [
    { "name": "id", "type": "uuid", "nullable": false, "primary_key": true },
    { "name": "company_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "companies", "column": "id", "on_delete": "restrict" } },
    { "name": "vendor_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "vendors", "column": "id", "on_delete": "restrict" } },
    { "name": "vendor_bill_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "vendor_bills", "column": "id", "on_delete": "cascade" } },
    { "name": "item_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "items", "column": "id", "on_delete": "restrict" } },
    { "name": "quantity", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "unit_price", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "tax_rate", "type": "numeric(5,2)", "nullable": false, "default": "0" },
    { "name": "sub_total", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "line_order", "type": "integer", "nullable": false, "default": "0" }
  ],
  "indexes": [
    { "name": "ix_vendor_bill_lines_company_bill", "columns": ["company_id", "vendor_bill_id"] },
    { "name": "ix_vendor_bill_lines_company_item", "columns": ["company_id", "item_id"] }
  ]
}
