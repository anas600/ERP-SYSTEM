{
  "name": "Notification",
  "table": "notifications",
  "version": "1.0.0",
  "module": "Inventory",
  "fields": [
    { "name": "id", "type": "uuid", "nullable": false, "primary_key": true },
    { "name": "company_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "companies", "column": "id", "on_delete": "restrict" } },
    { "name": "user_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "users", "column": "id", "on_delete": "cascade" } },
    { "name": "type", "type": "varchar(50)", "nullable": false },
    { "name": "title", "type": "varchar(200)", "nullable": false },
    { "name": "message", "type": "text", "nullable": false },
    { "name": "reference_type", "type": "varchar(50)", "nullable": true },
    { "name": "reference_id", "type": "uuid", "nullable": true },
    { "name": "is_read", "type": "boolean", "nullable": false, "default": "false" },
    { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()" },
    { "name": "read_at", "type": "timestamptz", "nullable": true }
  ],
  "indexes": [
    { "name": "ix_notifications_company_user", "columns": ["company_id", "user_id"] },
    { "name": "ix_notifications_company_user_unread", "columns": ["company_id", "user_id", "is_read"] },
    { "name": "ix_notifications_company_type", "columns": ["company_id", "type"] },
    { "name": "ix_notifications_company_created", "columns": ["company_id", "created_at"] }
  ]
}
